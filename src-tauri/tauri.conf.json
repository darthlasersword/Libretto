{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rune",
  "version": "0.5.0-alpha",
  "identifier": "app.rune.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun scripts/build-desktop.ts"
  },
  "app": {
    "windows": [
      {
        "title": "Rune",
        "create": false,
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
